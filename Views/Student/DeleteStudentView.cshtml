@model LA2_Duyongco.Models.Student

<h2 class="mt-4">Delete Student</h2>
<h4 class="text-danger mb-3">Are you sure you want to delete this student?</h4>

<!-- Reusing the Partial View Card -->
<partial name="_StudentDetailsCard" model="Model" />

<form asp-action="DeleteStudent" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="StudentListView" class="btn btn-secondary">Back to List</a>
</form>